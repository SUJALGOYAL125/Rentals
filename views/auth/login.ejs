<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="min-h-screen bg-gradient-to-br from-red-50 via-white to-orange-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
      <div class="w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden">
        <!-- Header Section -->
        <div class="bg-gradient-to-r from-red-500 to-red-600 px-8 py-12 text-center">
          <div class="text-6xl mb-3">🔐</div>
          <h1 class="text-4xl font-bold text-white mb-2">Welcome Back</h1>
          <p class="text-red-100 text-lg">Sign in to your account</p>
        </div>

        <!-- Form Section -->
        <div class="p-8 md:p-10">
          <form action="/login" method="POST" class="space-y-6">

            <%- include('../partials/errors') %>
            <!-- Email/Username Field -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">📧 Email</label>
              <input
                type="email"
                name="email"
                placeholder="john@example.com"
                value="<%= oldInput.email ? oldInput.email : ''%>"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition"
                required
              />
            </div>

            <!-- Password Field -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">🔒 Password</label>
              <input
                type="password"
                name="password"
                placeholder="••••••••"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition"
                required
              />
            </div>

            <!-- Remember Me & Forgot Password
            <div class="flex items-center justify-between">
              <label class="flex items-center cursor-pointer">
                <input type="checkbox" class="h-4 w-4 text-red-500 rounded" />
                <span class="ml-2 text-sm text-gray-600">Remember me</span>
              </label>
              <a href="#" class="text-sm text-red-600 hover:text-red-700 font-semibold">Forgot password?</a>
            </div> -->

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full bg-gradient-to-r from-red-500 to-red-600 text-white py-4 px-4 rounded-xl font-bold text-lg hover:from-red-600 hover:to-red-700 active:from-red-700 active:to-red-800 transition duration-300 ease-in-out transform hover:scale-105 shadow-lg hover:shadow-2xl"
            >
              🚀 Sign In
            </button>
          </form>

          <!-- Signup Link -->
          <div class="mt-8 pt-6 border-t border-gray-200 text-center">
            <p class="text-gray-600">
              Don't have an account?
              <a href="/signup" class="text-red-600 font-bold hover:text-red-700 transition">Create one here</a>
            </p>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>