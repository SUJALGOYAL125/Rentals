<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    <main class="min-h-screen bg-gradient-to-br from-red-50 via-white to-orange-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
      <div class="w-full max-w-2xl bg-white rounded-2xl shadow-2xl overflow-hidden">
        <!-- Header Section -->
        <div class="bg-gradient-to-r from-red-500 to-red-600 px-8 py-12 text-center">
          <div class="text-6xl mb-3">🏠</div>
          <h1 class="text-4xl font-bold text-white mb-2">Create Your Account</h1>
          <p class="text-red-100 text-lg">Join thousands of travelers and hosts</p>
        </div>

        <!-- Form Section -->
        <div class="p-8 md:p-10">
          <form action="/signup" method="POST" class="space-y-6">


          <%- include('../partials/errors') %>

            <!-- Name Fields -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">👤 First Name</label>
                <input
                  type="text"
                  name="firstName"
                  placeholder="John"
                  value="<%= oldInput.firstName ? oldInput.firstName : ''%>"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition"
                  required
                />
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">👤 Last Name</label>
                <input
                  type="text"
                  name="lastName"
                  placeholder="Doe"
                  value="<%= oldInput.lastName ? oldInput.lastName : ''%>"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition"
                  required
                />
              </div>
            </div>

            <!-- Email Field -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">📧 Email Address</label>
              <input
                type="email"
                name="email"
                placeholder="john@example.com"
                value="<%= oldInput.email ? oldInput.email : ''%>"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition"
                required
              />
            </div>

            <!-- Password Fields -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">🔒 Password</label>
                <input
                  type="password"
                  name="password"
                  placeholder="••••••••"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition"
                  required
                />
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">🔐 Confirm Password</label>
                <input
                  type="password"
                  name="confirmPassword"
                  placeholder="••••••••"
                  class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition"
                  required
                />
              </div>
            </div>

            <!-- User Type Selection -->
            <div class="bg-gradient-to-br from-orange-50 to-red-50 p-6 rounded-xl border-2 border-red-200">
              <label class="block text-sm font-bold text-gray-800 mb-4">👥 Choose Your Role</label>
              <div class="space-y-3">
                <label class="flex items-center p-4 bg-white rounded-lg border-2 border-transparent hover:border-red-400 cursor-pointer transition">
                  <input
                    type="radio"
                    name="userType"
                    value="guest"
                    id="guest"
                    class="h-5 w-5 text-red-500 cursor-pointer"
                    checked="<%= oldInput.userType === 'guest'%>"
                  />
                  <span class="ml-4 flex-1">
                    <span class="block text-sm font-bold text-gray-800">Guest</span>
                    <span class="text-xs text-gray-500">Browse and book amazing homes</span>
                  </span>
                  <span class="text-2xl">🏖️</span>
                </label>
                <label class="flex items-center p-4 bg-white rounded-lg border-2 border-transparent hover:border-red-400 cursor-pointer transition">
                  <input
                    type="radio"
                    name="userType"
                    value="host"
                    id="host"
                    class="h-5 w-5 text-red-500 cursor-pointer"
                    checked="<%= oldInput.userType === 'host'%>"
                  />
                  <span class="ml-4 flex-1">
                    <span class="block text-sm font-bold text-gray-800">Host</span>
                    <span class="text-xs text-gray-500">List and earn from your property</span>
                  </span>
                  <span class="text-2xl">🏠</span>
                </label>
              </div>
            </div>

            <!-- Terms Checkbox -->
            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 p-6 rounded-xl border-2 border-blue-200">
              <label class="flex items-start cursor-pointer group">
                <input
                  type="checkbox"
                  name="terms"
                  id="terms"
                  class="h-5 w-5 text-red-500 mt-0.5 cursor-pointer rounded"
                  required
                />
                <span class="ml-3 text-sm text-gray-700">
                  I agree to the <span class="font-bold text-red-600 group-hover:underline">Terms and Conditions</span> and <span class="font-bold text-red-600 group-hover:underline">Privacy Policy</span>
                </span>
              </label>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full bg-gradient-to-r from-red-500 to-red-600 text-white py-4 px-4 rounded-xl font-bold text-lg hover:from-red-600 hover:to-red-700 active:from-red-700 active:to-red-800 transition duration-300 ease-in-out transform hover:scale-105 shadow-lg hover:shadow-2xl"
            >
              ✨ Create Account
            </button>
          </form>

          <!-- Login Link -->
          <div class="mt-8 pt-6 border-t border-gray-200 text-center">
            <p class="text-gray-600">
              Already have an account?
              <a href="/login" class="text-red-600 font-bold hover:text-red-700 transition">Login here</a>
            </p>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>